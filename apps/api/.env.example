# ============================================================================
# Lawmedy API environment
# Copy to apps/api/.env for local work. On Render, set the same keys under
# the service's Environment tab. Never commit the real .env file.
# Legend:  REQUIRED = the app will not work without it
#          OPTIONAL = a feature switches off if it is missing
# ============================================================================

# ---------- Database (REQUIRED) ----------
# Supabase: Project -> Connect.
# DATABASE_URL = the POOLED string (Transaction pooler, port 6543). Used by the running API.
#   Must end with ?pgbouncer=true. Username is postgres.<project-ref>.
# DIRECT_URL = the DIRECT string (port 5432). Used only for migrations. No ?pgbouncer here.
#   If your host cannot reach the direct (IPv6-only) address, use the Session pooler
#   string (port 5432 on the pooler.supabase.com host) instead.
# URL-encode special characters in the password (@ -> %40, / -> %2F, # -> %23).
DATABASE_URL=postgresql://postgres.project-ref:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.project-ref.supabase.co:5432/postgres

# ---------- Server (REQUIRED) ----------
# Random secrets of 32+ characters. Generate each with: openssl rand -base64 36
# Use DIFFERENT values for JWT_SECRET and FILE_SIGNING_SECRET.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FILE_SIGNING_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
# The website's origin, for CORS. Local: http://localhost:3000. Live: https://lawmedy.vercel.app
WEB_ORIGIN=http://localhost:3000
PORT=4000
# Leave unset locally (binds to 127.0.0.1). On a host such as Render, set 0.0.0.0
# (the Docker image already does).
HOST=

# ---------- AI (REQUIRED for drafting) ----------
# Key from https://aistudio.google.com -> Get API key. Use a billing-enabled project
# before real users upload documents.
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.8-flash

# ---------- Files (REQUIRED) ----------
# Uploaded evidence and final PDFs are stored on local disk here.
# NOTE: on Render this folder is wiped on every deploy unless a persistent disk is attached.
PRIVATE_STORAGE_DIR=.local/private-files
EVIDENCE_MAX_BYTES=10485760
# Path to Chrome/Chromium for PDF generation. Leave empty locally (auto-detected).
# The Docker image sets /usr/bin/chromium.
CHROMIUM_EXECUTABLE_PATH=

# ---------- Pricing, in paise (100 paise = Rs 1) ----------
LEGAL_NOTICE_PRICE_PAISE=29900
RTI_PRICE_PAISE=29900

# ---------- Seed accounts (used by: node prisma/seed.mjs) ----------
# Optional admin account with full dashboard access (12+ char password):
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Run: node prisma/seed.mjs. Creates/updates this advocate login.
# Use a strong password of 12+ characters and CHANGE it for production.
ADVOCATE_EMAIL=advocate@example.com
ADVOCATE_FULL_NAME=Lawmedy Advocate
ADVOCATE_PASSWORD=replace-with-a-strong-password-at-least-12-characters

# ---------- Payment mode ----------
# manual   = user pays on PAYMENT_LINK_URL, submits the payment reference, and an admin
#            verifies it in the admin dashboard. No API keys needed.
# razorpay = automatic checkout. Needs the three RAZORPAY_* keys below.
PAYMENT_MODE=manual
PAYMENT_LINK_URL=https://razorpay.me/@your-handle

# ---------- Payments: Razorpay (only for PAYMENT_MODE=razorpay) ----------
# Without these, matters cannot be paid and the draft step stays locked.
# razorpay.com -> Settings -> API Keys (use TEST keys first).
# Webhook: Settings -> Webhooks, URL https://<your-api>/payments/razorpay/webhook, event payment.captured.
RAZORPAY_KEY_ID=replace-with-your-test-key-id
RAZORPAY_KEY_SECRET=replace-with-your-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-test-webhook-secret

# ---------- Email: Resend (OPTIONAL) ----------
# Sends the "your document is ready" email. If blank or starting with "replace-",
# the email is skipped and only the in-app notification appears.
# resend.com -> verify a domain -> API Keys (Sending access).
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM=replace-with-Lawmedy <no-reply@your-domain.example>

# ---------- Google sign-in (OPTIONAL) ----------
# Comma-separated OAuth client IDs (Web + iOS) accepted as the ID-token audience.
# Without it, "Continue with Google" is unavailable; email sign-up still works.
GOOGLE_CLIENT_IDS=replace-with-google-oauth-client-ids

# Models tried in order if GEMINI_MODEL returns 503/429/timeout (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash
