# Public build-time URLs only. Never put API secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_WEB_URL=https://www.lawmedy.in
# A physical phone needs your development computer's LAN IP instead of 127.0.0.1.
# For EAS preview/production, configure an HTTPS API URL in that EAS environment.
