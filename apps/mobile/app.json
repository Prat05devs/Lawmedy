{
  "expo": {
    "name": "Lawmedy",
    "slug": "lawmedy",
    "scheme": "lawmedy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f6f2ea",
    "ios": {
      "bundleIdentifier": "com.lawmedy.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Lawmedy uses the camera so you can photograph documents to attach to your matter.",
        "NSPhotoLibraryUsageDescription": "Lawmedy lets you choose photos of documents to attach to your matter.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.lawmedy.app",
      "adaptiveIcon": {
        "backgroundColor": "#f6f2ea",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#f6f2ea",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://lawmedy-api.onrender.com"
    }
  }
}
