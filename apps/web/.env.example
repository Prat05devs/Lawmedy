# ============================================================================
# Lawmedy web environment
# Copy to apps/web/.env.local for local work. For Hostinger, see docs/deploy-vps.md.
# Public NEXT_PUBLIC_* values must be set when building the website.
# ============================================================================

# ---------- API (REQUIRED) ----------
# The Lawmedy API's base URL, used server-side by the web app.
# Local: http://127.0.0.1:4000     Live: https://api.your-domain.example (DigitalOcean VPS)
API_URL=http://127.0.0.1:4000

# ---------- Public site details (shown on the legal and support pages) ----------
# Your live domain, used in the sitemap and robots file.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# A real, monitored mailbox. App Store and Play Store reviewers will check it.
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.example
# Team Lawmedy WhatsApp number (digits with country code). Finished PDFs are sent from it.
NEXT_PUBLIC_WHATSAPP_NUMBER=916399907916
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@your-domain.example
# Optional postal address shown on the Contact and Privacy pages. Leave blank to hide.
NEXT_PUBLIC_BUSINESS_ADDRESS=

# ---------- Google sign-in (OPTIONAL) ----------
# Web OAuth client ID. Leave blank to hide the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public API URL for the advocate-interest form (no credentials).
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Exact browser origin used to validate state-changing requests behind the hosting proxy.
# Production: set this to the exact HTTPS website origin.
APP_ORIGIN=http://localhost:3000
