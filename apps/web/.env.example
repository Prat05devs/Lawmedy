# ============================================================================
# Lawmedy web environment
# Copy to apps/web/.env.local for local work. On Vercel, set the same keys
# under Project -> Settings -> Environment Variables, then redeploy.
# ============================================================================

# ---------- API (REQUIRED) ----------
# The Lawmedy API's base URL, used server-side by the web app.
# Local: http://127.0.0.1:4000     Live: your Render URL, e.g. https://lawmedy-api.onrender.com
API_URL=http://127.0.0.1:4000

# ---------- Public site details (shown on the legal and support pages) ----------
# Your live domain, used in the sitemap and robots file.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# A real, monitored mailbox. App Store and Play Store reviewers will check it.
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.example
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@your-domain.example
# Optional postal address shown on the Contact and Privacy pages. Leave blank to hide.
NEXT_PUBLIC_BUSINESS_ADDRESS=

# ---------- Google sign-in (OPTIONAL) ----------
# Web OAuth client ID. Leave blank to hide the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
