# Copy privately to /opt/apps/lawmedy/current/deploy/shared/.env (chmod 600).
# This Compose project uses the existing /opt/platform Caddy and PostgreSQL.
COMPOSE_PROJECT_NAME=lawmedy
RELEASE_TAG=replace-with-release-id
BACKUP_DIR=/opt/apps/lawmedy/backups
DATABASE_URL=postgresql://lawmedy:replace-with-lawmedy-password@postgres:5432/lawmedy?schema=public&connection_limit=5&pool_timeout=20
DIRECT_URL=postgresql://lawmedy:replace-with-lawmedy-password@postgres:5432/lawmedy?schema=public&connection_limit=5&pool_timeout=20
JWT_SECRET=replace-with-random-secret-at-least-32-characters
FILE_SIGNING_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
CONFIG_ENCRYPTION_KEY=replace-with-64-random-hex-characters
WEB_ORIGIN=https://lawmedy.in,https://www.lawmedy.in
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
GEMINI_FALLBACK_MODELS=
PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LEGAL_NOTICE_PRICE_PAISE=29900
RTI_PRICE_PAISE=29900
LENDING_CERTIFICATE_PRICE_PAISE=19900
RESEND_API_KEY=
RESEND_FROM=
GOOGLE_CLIENT_IDS=
EVIDENCE_MAX_BYTES=10485760
EVIDENCE_MAX_FILES=10
ADMIN_EMAIL=
ADMIN_FULL_NAME=Lawmedy Admin
ADMIN_PASSWORD=
ADVOCATE_EMAIL=
ADVOCATE_FULL_NAME=Lawmedy Advocate
ADVOCATE_PASSWORD=
