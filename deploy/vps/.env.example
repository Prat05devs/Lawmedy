# Copy to deploy/vps/.env on the VPS; never commit the filled file.
API_DOMAIN=api.your-domain.example
ACME_EMAIL=admin@your-domain.example
# Generate DIFFERENT hex passwords: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-db-admin-hex-password
LAWMEDY_DB_PASSWORD=replace-with-lawmedy-hex-password
DATABASE_URL=postgresql://lawmedy:${LAWMEDY_DB_PASSWORD}@postgres:5432/lawmedy?schema=public&connection_limit=5&pool_timeout=20
DIRECT_URL=postgresql://lawmedy:${LAWMEDY_DB_PASSWORD}@postgres:5432/lawmedy?schema=public&connection_limit=5&pool_timeout=20
CONFIG_ENCRYPTION_KEY=replace-with-64-random-hex-characters
JWT_SECRET=replace-with-random-secret-at-least-32-characters
FILE_SIGNING_SECRET=replace-with-a-different-random-secret-at-least-32-characters
WEB_ORIGIN=https://www.your-domain.example
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=
LEGAL_NOTICE_PRICE_PAISE=29900
RTI_PRICE_PAISE=29900
LENDING_CERTIFICATE_PRICE_PAISE=19900
EVIDENCE_MAX_BYTES=10485760
EVIDENCE_MAX_FILES=10
# Valid API keys select Razorpay automatically, including with an old manual setting.
PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Choose a separate secret and register payment.captured in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=
GOOGLE_CLIENT_IDS=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADVOCATE_EMAIL=
ADVOCATE_FULL_NAME=Lawmedy Advocate
ADVOCATE_PASSWORD=
